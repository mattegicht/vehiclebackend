# Copy to .env and fill in real values. The .env file is gitignored.
# docker-compose reads .env automatically; for local `mvn spring-boot:run`,
# export these as environment variables.

# MySQL root password (also used by the app to connect to the DB).
DB_PASSWORD=

# JWT signing secret — must be >= 32 chars.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Bootstrap admin account. Leave the password blank to seed NO admin (no backdoor).
# Set a strong password to have an admin created on first startup.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Optional demo user — only seeded if a password is set.
SEED_DEMO_USERNAME=demo
SEED_DEMO_PASSWORD=

# Comma-separated browser origins allowed to make credentialed CORS requests
# (only relevant for Flutter *web* clients; native apps send no Origin header).
# List EVERY origin the web app is reachable from, including bare-IP access,
# e.g. CORS_ALLOWED_ORIGINS=https://vehiclebackend.duckdns.org,https://192.168.54.25:9443
# Defaults to https://vehiclebackend.duckdns.org if unset.
CORS_ALLOWED_ORIGINS=https://vehiclebackend.duckdns.org,https://192.168.54.25:9443

# Email for self-service "Passwort vergessen" reset links. ALL OPTIONAL:
# with MAIL_HOST left blank the app still boots and logs the reset link to the
# server console instead of sending an email.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
# Two mutually exclusive TLS modes:
#   STARTTLS (default, port 587): MAIL_STARTTLS=true,  MAIL_SSL=false, MAIL_PORT=587
#   Implicit SSL (port 465):      MAIL_STARTTLS=false, MAIL_SSL=true,  MAIL_PORT=465
MAIL_STARTTLS=true
MAIL_SSL=false
MAIL_FROM=no-reply@vehiclebackend.duckdns.org
# SMTP connect/read timeout in ms (fail fast if the port is blocked).
MAIL_TIMEOUT_MS=10000

# Public web-app URL used to build the reset link (…/?reset=<token>).
APP_FRONTEND_URL=https://vehiclebackend.duckdns.org

# Reset-token lifetime in minutes.
PASSWORD_RESET_TTL_MINUTES=60

# Login brute-force lockout: this many failed logins for the same username inside
# the window locks that username for LOGIN_LOCKOUT_MINUTES (the endpoint then
# answers 429). A successful login or any password change clears the counter.
# Set LOGIN_MAX_ATTEMPTS=0 to switch the lockout off.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Copy to .env and fill in real values. The .env file is gitignored.
# docker-compose reads .env automatically; for local `mvn spring-boot:run`,
# export these as environment variables.

# MySQL root password (also used by the app to connect to the DB).
DB_PASSWORD=

# JWT signing secret — must be >= 32 chars.
# Generate with: openssl rand -hex 32
JWT_SECRET=
